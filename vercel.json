{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/release-stale-credits",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/refresh-stats",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/purge-scan-results",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/alert-track",
      "schedule": "7 * * * *"
    }
  ]
}

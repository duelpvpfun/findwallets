# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local data exports and screenshots
highpnl*.json
# Pre-change dumps written by scripts/merge-duplicate-tokens.mjs — archive data, keep local
backup-merge-tokens-*.json
*.png
# ...but the venue logos are shipped assets, not a stray screenshot. The blanket
# rule above meant they were silently absent from the deploy and every Buy icon
# on /feed 404'd.
!public/venues/*.png
.keys/

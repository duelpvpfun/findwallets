{
  "name": "findwallets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint",
    "typecheck": "tsc --noEmit",
    "check": "bash -c 'tsc --noEmit & p1=$!; eslint --cache --cache-location node_modules/.cache/eslint & p2=$!; wait $p1; t=$?; wait $p2; l=$?; echo \"TSC=$t LINT=$l\"; exit $((t|l))'",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "webhook:log": "env -u DATABASE_URL bash -c 'set -a; source .env.local; set +a; node scripts/webhook-log.mjs'",
    "enrich": "env -u DATABASE_URL node --env-file=.env.local scripts/enrich-wallets.mjs",
    "enrich:stats": "env -u DATABASE_URL node --env-file=.env.local scripts/enrich-stats.mjs",
    "db:health": "env -u DATABASE_URL node --env-file=.env.local scripts/db-health.mjs",
    "db:prune": "env -u DATABASE_URL node --env-file=.env.local scripts/db-prune.mjs",
    "test:credits": "env -u DATABASE_URL node --env-file=.env.local scripts/credit-lifecycle.mjs",
    "test:accounts": "env -u DATABASE_URL node --env-file=.env.local scripts/account-lifecycle.mjs",
    "db:migrate": "env -u DATABASE_URL node --env-file=.env.local scripts/apply-migration.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/functions": "^3.9.3",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

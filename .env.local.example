# Copy this file to .env.local and fill in your key(s). .env.local is gitignored.

# Solana Tracker Data API key (https://data.solanatracker.io) — used for
# Solana top-traders-by-token ranking and wallet PNL/activity data.
SOLANA_TRACKER_API_KEY=

# Birdeye Data API key (https://bds.birdeye.so) — used for BNB Chain and Base
# top-traders ranking and wallet PNL/activity data. Optional; without it, BSC/Base
# searches fall back to demo data just like Solana does without its key.
BIRDEYE_API_KEY=

# Postgres connection string (e.g. Vercel Postgres / Neon / Supabase). Optional —
# without it the app works exactly the same, it just won't persist scanned wallets.
# Run `npx drizzle-kit push` once after setting this to create the tables.
DATABASE_URL=

# --- Payments (Helio) -------------------------------------------------------
# Turn the paywall on. Leave unset/false and every scan stays free.
# Both must be set to the same value: the server enforces, the client renders prices.
PAYMENTS_ENABLED=
NEXT_PUBLIC_PAYMENTS_ENABLED=

# Shared token Helio sends as the Authorization bearer on each webhook call.
# Helio issues one token per webhook, so list all of them comma-separated:
#   HELIO_WEBHOOK_SECRET=tokenFor50,tokenFor100,tokenFor250,tokenFor500
# Without it, no credits can ever be minted, so payments will not unlock scans.
HELIO_WEBHOOK_SECRET=

# Your personal bypass key — unlimited free scans. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Install it in your browser once by visiting https://yourdomain.com/?key=THEKEY
OWNER_ACCESS_KEY=

# Copy this file to .env.local and fill in your key(s). .env.local is gitignored.

# Solana Tracker Data API key (https://data.solanatracker.io) — used for
# Solana top-traders-by-token ranking and wallet PNL/activity data.
SOLANA_TRACKER_API_KEY=

# Birdeye Data API key (https://bds.birdeye.so) — used for BNB Chain and Base
# top-traders ranking and wallet PNL/activity data. Optional; without it, BSC/Base
# searches fall back to demo data just like Solana does without its key.
BIRDEYE_API_KEY=

# Postgres connection string (e.g. Vercel Postgres / Neon / Supabase). Optional —
# without it the app works exactly the same, it just won't persist scanned wallets.
# Run `npx drizzle-kit push` once after setting this to create the tables.
#
# MUST be the POOLED / pgBouncer transaction-mode string (Supabase port 6543,
# Neon "-pooler" host), not the direct connection. Every serverless invocation
# opens its own pool, so direct connections exhaust the database's cap under
# very little concurrency.
DATABASE_URL=

# --- Payments (own Solana/USDC settlement) ----------------------------------
# Turn the paywall on. Leave unset/false and every scan stays free.
# Both must be set to the same value: the server enforces, the client renders prices.
PAYMENTS_ENABLED=
NEXT_PUBLIC_PAYMENTS_ENABLED=

# Public Solana wallet address that receives buyer payments (SOL/USDC).
SOLANA_TREASURY_WALLET=

# Helius API key (https://dev.helius.xyz) — used server-side only, to build
# transactions and to verify a signature actually landed and paid the
# expected amount before minting a credit. Without it, no credits can be
# minted, so payments will not unlock scans.
HELIUS_API_KEY=

# Your personal bypass key — unlimited free scans. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Install it in your browser once by visiting https://yourdomain.com/?key=THEKEY
OWNER_ACCESS_KEY=

# --- Wallet accounts --------------------------------------------------------
# Signing key for the user session cookie (aw_user). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Optional: unset, it derives a key from OWNER_ACCESS_KEY instead, so a missing
# var can never silently disable signing. Setting it explicitly means rotating
# OWNER_ACCESS_KEY doesn't sign every user out. If BOTH are unset, wallet
# sign-in is simply unavailable and the app stays anonymous-only.
AUTH_SESSION_SECRET=

# --- Rate limiting ----------------------------------------------------------
# Upstash Redis (https://console.upstash.com) — makes rate limits one shared
# budget across every serverless instance. Without these the limiter falls back
# to per-instance memory, where the real limit is limit x instance_count.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron -------------------------------------------------------------------
# Shared secret for /api/cron/* (Vercel Cron sends it as `Bearer $CRON_SECRET`).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset means every cron endpoint returns 401.
CRON_SECRET=

# --- Error monitoring -------------------------------------------------------
# Sentry (https://sentry.io). Optional; unset disables reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for uploading source maps at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Smart money alerts ------------------------------------------------------
# Shared secret Helius sends back as `Authorization: Bearer $HELIUS_WEBHOOK_SECRET`
# on every stream delivery. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset means /api/stream/solana rejects everything — a missing secret denies
# rather than opens the endpoint, since anyone who knew the URL could otherwise
# inject fabricated buys straight into the alerts.
HELIUS_WEBHOOK_SECRET=

# Telegram bot that posts alerts. From @BotFather.
TELEGRAM_BOT_TOKEN=
# Where alerts are posted: a channel username (@yourchannel) or a numeric chat id.
# The bot must be an admin of the channel with "Post Messages".
TELEGRAM_ALERT_CHAT_ID=
# Public join link shown on /alerts. Just the username, e.g. yourchannel.
NEXT_PUBLIC_TELEGRAM_CHANNEL=

# Forward every classified trade to Telegram unaggregated, with no thresholds.
# The verification mode: buy classification is the one part of this system that
# can't be proven correct by reading it, so turn this on for a few hours, check
# the lines against Solscan, then turn it off. Never leave it on in production.
ALERTS_RAW_MODE=

# Referral codes for the buttons under every alert. Unset just means the plain
# link, so a missing code costs commission rather than breaking the message.
# Scoped by chain in src/lib/alerts/config.ts: Axiom and Trojan are Solana,
# GMGN covers all three, BasedBot is Base.
ALERTS_REF_AXIOM=
ALERTS_REF_TROJAN=
ALERTS_REF_GMGN=
ALERTS_REF_BASEDBOT=

# Where Helius should POST. Defaults to NEXT_PUBLIC_SITE_URL, then production.
# Set this to point a webhook at a preview deploy or an ngrok tunnel.
ALERTS_WEBHOOK_URL=
